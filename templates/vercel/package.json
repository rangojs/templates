    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.3",
