{
  "name": "rango-template-cloudflare",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "rango generate src/",
    "dev": "vite",
    "prebuild": "rango generate src/",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "rango generate src/ && vite build && wrangler deploy -c dist/rsc/wrangler.json",
    "generate": "rango generate src/",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "check": "tsc --noEmit && vitest run && oxlint --deny-warnings . && oxfmt --check ."
  },
  "dependencies": {
    "@rangojs/router": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "@cloudflare/workers-types": "^5.20260708.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
