{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/triple-slash-reference": "off"
  },
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    ".vercel/",
    ".vite/",
    ".wrangler/",
    "packages/create-rango/templates/"
  ]
}
